meta {
  name: Get Departments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/departments
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("returns a list", function () {
    expect(res.getBody()).to.be.an("array");
  });
  
  test("every department has id, name and benefits", function () {
    res.getBody().forEach(function (department) {
      expect(department).to.have.property("id");
      expect(department).to.have.property("name");
      expect(department.benefits).to.be.an("array");
    });
  });
}

docs {
  Returns every department. `GET /departments`
}
