meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.access_token);
}

docs {
  Exchanges credentials for a JWT. `POST /auth/token` with a JSON body.
  
  Change the body to exercise invalid credentials.
}
